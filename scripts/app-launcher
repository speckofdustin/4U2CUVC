#!/bin/bash

set -u

PORT=3847
URL="http://localhost:$PORT"
JOB_LABEL="io.github.4u2ctheuvc.server"
JOB_TARGET="gui/$(id -u)/$JOB_LABEL"

if ! curl -fsS --max-time 2 "$URL/api/health" >/dev/null 2>&1; then
  launchctl kickstart -k "$JOB_TARGET" >/dev/null 2>&1 || true
  for _ in {1..40}; do
    curl -fsS --max-time 2 "$URL/api/health" >/dev/null 2>&1 && break
    sleep 0.25
  done
fi

if curl -fsS --max-time 2 "$URL/api/health" >/dev/null 2>&1; then
  open "$URL"
  exit 0
fi

osascript -e 'display alert "4U2CtheUVC could not start" message "Run the installer again, then check ~/Library/Application Support/4U2CtheUVC/server.log for details." as critical'
exit 1
