{
  "version": "0.1.0",
  "description": "Canonical portable CSS custom properties. Run node scripts/build-tokens.cjs after editing. Values are CSS strings; alpha hex is intentional.",
  "base": {
    "--flow-sans": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif",
    "--flow-mono": "ui-monospace,\"SFMono-Regular\",Menlo,monospace",
    "--flow-panel-radius": "12px",
    "--flow-control-radius": "5px",
    "--flow-control-height": "31px",
    "--flow-panel-padding": "0 14px 15px",
    "--flow-panel-shadow": "0 8px 28px #17200c08",
    "--flow-popup-shadow": "0 10px 40px #0003",
    "--flow-panel-blur": "20px",
    "--flow-filled": "color-mix(in srgb,var(--flow-ink) 13%,var(--flow-well))",
    "--flow-invalid": "#bf614e"
  },
  "themes": {
    "light": {"--flow-background":"#f0f0f0","--flow-paper":"#faf9f5f5","--flow-ink":"#30352e","--flow-muted":"#757b70","--flow-line":"#343d2826","--flow-well":"#535e3e0c","--flow-active":"#525d3d18","color-scheme":"light"},
    "dark": {"--flow-background":"#151714","--flow-paper":"#22251fee","--flow-ink":"#e1e5d9","--flow-muted":"#9a9f91","--flow-line":"#dbe2ce25","--flow-well":"#dce3d30b","--flow-active":"#dce3d320","color-scheme":"dark"}
  }
}
